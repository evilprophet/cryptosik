### ---------------------------------------------------------------------------
### App Runtime
### ---------------------------------------------------------------------------

# Application name displayed in UI.
APP_NAME=Cryptosik

# Application mode:
# - prod: random OTP code is generated and sent by email
# - dev:  fixed OTP code (CRYPTOSIK_DEV_OTP_CODE) is shown on the login page and
#         no email is sent. Requires APP_ENV to be something other than
#         "production" - dev mode is ignored on a production environment.
APP_MODE=prod

# Laravel runtime environment.
APP_ENV=production
APP_DEBUG=false

# --- Local development ------------------------------------------------------
# Replace the three values above with this block when working locally, and add the
# cookie override - local development runs over plain HTTP, where a Secure cookie
# is never sent back and login silently fails:
#   APP_MODE=dev
#   APP_ENV=local
#   APP_DEBUG=true
#   SESSION_SECURE_COOKIE=false
# ----------------------------------------------------------------------------

# Public base URL used by Laravel URL generation.
APP_URL=http://localhost

# Application timezone used for dates and times.
APP_TIMEZONE=Europe/Warsaw

# Trusted reverse proxies used for X-Forwarded-* headers.
# Use REMOTE_ADDR for a single local proxy hop, or comma-separated IP/CIDR list.
# Example: TRUSTED_PROXIES=REMOTE_ADDR
#
# Do NOT use "*". It makes the client-supplied X-Forwarded-For header decide the
# request IP, and the brute-force limits on admin login, OTP verification and vault
# unlock are keyed on that IP - rotating the header would bypass all of them.
TRUSTED_PROXIES=

# The session cookie is marked Secure by default, so browsers only send it over HTTPS.
# If you reach the app over plain HTTP - the shipped docker-compose publishes port 8080
# with no TLS - uncomment this line, otherwise logging in silently fails.
#SESSION_SECURE_COOKIE=false

# Default UI language (en, pl, de, es).
APP_LOCALE=en

# Fallback language when translation key is missing.
APP_FALLBACK_LOCALE=en

# Application encryption key. The container refuses to start without it.
# Local:  php artisan key:generate
# Docker: docker compose run --rm app php artisan key:generate --show
#         (copy the printed value here, including the "base64:" prefix)
APP_KEY=

### ---------------------------------------------------------------------------
### Database
### ---------------------------------------------------------------------------

# Choose one variant by setting DB_CONNECTION and keeping matching variables.
# Supported variants: mysql, sqlite

# --- MySQL variant ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cryptosik
# DB_USERNAME=cryptosik
# DB_PASSWORD=cryptosik

# --- SQLite variant ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

### ---------------------------------------------------------------------------
### Cryptosik Security
### ---------------------------------------------------------------------------

# OTP code used only when APP_MODE=dev.
CRYPTOSIK_DEV_OTP_CODE=111111

# Brute-force throttling on authentication edges.
# Attempts are counted per (identity + IP) and reset after a successful attempt.
CRYPTOSIK_ADMIN_LOGIN_MAX_ATTEMPTS=5
CRYPTOSIK_ADMIN_LOGIN_DECAY_MINUTES=15
CRYPTOSIK_OTP_VERIFY_MAX_ATTEMPTS=10
CRYPTOSIK_OTP_VERIFY_DECAY_MINUTES=15
CRYPTOSIK_VAULT_UNLOCK_MAX_ATTEMPTS=10
CRYPTOSIK_VAULT_UNLOCK_DECAY_MINUTES=15

# Weekly unread notification cron (default: Saturday 09:00).
# Cron format: minute hour day-of-month month day-of-week
CRYPTOSIK_NOTIFICATIONS_WEEKLY_UNREAD_CRON="0 9 * * 6"

# Audit log retention in days.
# Allowed values: never, 30, 60, 90, 120
CRYPTOSIK_AUDIT_LOG_RETENTION_DAYS=never

# Audit log cleanup cron (default: every day at 03:15).
# Cron format: minute hour day-of-month month day-of-week
CRYPTOSIK_AUDIT_LOG_PRUNE_CRON="15 3 * * *"

# How often the hash chain of every vault is verified, in hours (1-23).
CRYPTOSIK_CHAIN_VERIFY_EVERY_HOURS=3

# Max message content length in characters.
CRYPTOSIK_ENTRY_CONTENT_CHARS_LIMIT=2000000

# Admin panel URL path prefix (without leading slash).
CRYPTOSIK_ADMIN_PATH=admin

### ---------------------------------------------------------------------------
### Cryptosik Tuning (all optional - defaults shown, uncomment to override)
### ---------------------------------------------------------------------------

# --- OTP login codes ---

# Lifetime of a login code in minutes.
#CRYPTOSIK_OTP_TTL_MINUTES=10

# Wrong-code attempts before that code is locked out.
#CRYPTOSIK_OTP_MAX_ATTEMPTS=5

# Lock duration in minutes once the attempt limit is reached.
#CRYPTOSIK_OTP_LOCK_MINUTES=15

# Code requests allowed per email+IP within the window below.
#CRYPTOSIK_OTP_REQUEST_MAX_PER_WINDOW=5
#CRYPTOSIK_OTP_REQUEST_WINDOW_MINUTES=15

# --- Argon2id key derivation ---
#
# These values are recorded per vault at creation time and read back on unlock,
# so changing them affects only vaults created afterwards - existing vaults keep
# opening with the parameters they were created with. There is no rekey command,
# so an existing vault stays at its original cost until it is recreated.
#
# Defaults are the libsodium MODERATE presets. Raising memlimit raises the peak
# RAM of a single unlock request.
#CRYPTOSIK_ARGON_OPSLIMIT=3
#CRYPTOSIK_ARGON_MEMLIMIT=268435456

# --- Limits ---

# Max attachments per single entry.
#CRYPTOSIK_ATTACHMENTS_PER_ENTRY_LIMIT=10

# Max size of a single attachment in bytes (default 10 MiB).
#CRYPTOSIK_ATTACHMENT_SIZE_LIMIT_BYTES=10485760

# Max nickname length in characters.
# Do not raise above 80 - the users.nickname column is VARCHAR(80).
#CRYPTOSIK_USER_NICKNAME_CHARS_LIMIT=80

### ---------------------------------------------------------------------------
### Mail (SMTP)
### ---------------------------------------------------------------------------

# Mail transport. For production OTP delivery use smtp.
MAIL_MAILER=smtp

# SMTP host and port.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# SMTP credentials.
# For Gmail use full account email and an App Password.
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password

# Sender address and display name.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
